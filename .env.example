# Sao chép thành .env rồi sửa theo máy của bạn. Không commit file .env.
# Biến nào bỏ trống hoặc không khai báo thì dùng giá trị mặc định trong src/bpllm/config.py.

# ---------- Qdrant (docker_compose.yml cũng đọc hai biến cổng) ----------
# Cổng khác repo cũ (6333/6334) để hai bản chạy song song được
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6343
QDRANT_GRPC_PORT=6344
QDRANT_PREFER_GRPC=true

# Hai collection cố định, mỗi collection một kiểu chunk. Không dùng chung một biến cho cả hai.
QDRANT_COLLECTION_SPECIFIC=bpllm2_specific
QDRANT_COLLECTION_ENRICHED=bpllm2_enriched

# ---------- Embedding ----------
# Đổi model thì phải chạy lại scripts/build_vector_store.py và scripts/retrieve_top_k.py
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=10

# ---------- Streamlit ----------
# Kiểu chunk app dùng để trả lời: enriched (chính xác nhất) hoặc specific (như bài báo)
APP_CHUNKING=enriched

# ---------- LLM (server chuẩn OpenAI chạy trên Kaggle, notebooks/bpllm_server_kaggle.ipynb) ----------
# Dán URL notebook in ra, có đuôi /v1, ví dụ https://abc-def.trycloudflare.com/v1
LLM_BASE_URL=http://localhost:8000/v1
# Phải trùng API_KEY đặt trong notebook server
LLM_API_KEY=change-me
# Bản model app gọi: int4 (server notebook nạp bản int4)
LLM_QUANT=int4
LLM_MAX_TOKENS=256
LLM_TIMEOUT=300
