# Sao chép thành .env rồi chỉnh theo máy của bạn. Không commit file .env.
# Bỏ trống hoặc không khai báo thì dùng giá trị mặc định trong src/bpllm/config.py.

# Qdrant (docker_compose.yml cũng đọc hai biến cổng bên dưới)
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true
QDRANT_COLLECTION=bpllm_processes

# Đổi model thì phải chạy lại scripts/build_vector_store.py
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
