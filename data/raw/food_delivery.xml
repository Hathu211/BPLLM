<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_FD" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Kimi" exporterVersion="1.0">
  <bpmn:process id="Process_FoodDelivery" name="Food Delivery" isExecutable="false">
    <bpmn:startEvent id="fd_start" name="User order received"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="fd_verify" name="Verify customer status in customer DB"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="fd_gw_existing" name="Existing client?" default="f3_no"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3_no</bpmn:outgoing><bpmn:outgoing>f3_yes</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="fd_create_account" name="Create account for customer"><bpmn:incoming>f3_no</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="fd_check_payment" name="Check specified payment methods"><bpmn:incoming>f3_yes</bpmn:incoming><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="fd_assign_rider" name="Assign order to accepting rider"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="fd_comm_wait" name="Communicate estimated waiting time to customer"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="fd_rider_collect" name="Rider collects order"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:intermediateCatchEvent>
    <bpmn:task id="fd_notify_client" name="Send notification to client"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="fd_client_receipt" name="Client confirms receipt"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:intermediateCatchEvent>
    <bpmn:task id="fd_unlock_payment" name="Unlock rider's payment"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="fd_end" name="Process complete"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="fd_start" targetRef="fd_verify"/>
    <bpmn:sequenceFlow id="f2" sourceRef="fd_verify" targetRef="fd_gw_existing"/>
    <bpmn:sequenceFlow id="f3_no" sourceRef="fd_gw_existing" targetRef="fd_create_account" name="No"/>
    <bpmn:sequenceFlow id="f3_yes" sourceRef="fd_gw_existing" targetRef="fd_check_payment" name="Yes"/>
    <bpmn:sequenceFlow id="f4" sourceRef="fd_create_account" targetRef="fd_check_payment"/>
    <bpmn:sequenceFlow id="f5" sourceRef="fd_check_payment" targetRef="fd_assign_rider"/>
    <bpmn:sequenceFlow id="f6" sourceRef="fd_assign_rider" targetRef="fd_comm_wait"/>
    <bpmn:sequenceFlow id="f7" sourceRef="fd_comm_wait" targetRef="fd_rider_collect"/>
    <bpmn:sequenceFlow id="f8" sourceRef="fd_rider_collect" targetRef="fd_notify_client"/>
    <bpmn:sequenceFlow id="f9" sourceRef="fd_notify_client" targetRef="fd_client_receipt"/>
    <bpmn:sequenceFlow id="f10" sourceRef="fd_client_receipt" targetRef="fd_unlock_payment"/>
    <bpmn:sequenceFlow id="f12" sourceRef="fd_unlock_payment" targetRef="fd_end"/>
  </bpmn:process>
</bpmn:definitions>
