<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_RE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Kimi" exporterVersion="1.0">
  <bpmn:process id="Process_Reimbursement" name="Reimbursement" isExecutable="false">
    <bpmn:startEvent id="re_start" name="Expense report received from employee"><bpmn:outgoing>r1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="re_notify" name="Notify employee"><bpmn:incoming>r1</bpmn:incoming><bpmn:outgoing>r2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="re_gw_account" name="Account exists?" default="r3_no"><bpmn:incoming>r2</bpmn:incoming><bpmn:outgoing>r3_no</bpmn:outgoing><bpmn:outgoing>r3_yes</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="re_create_account" name="Create account for employee"><bpmn:incoming>r3_no</bpmn:incoming><bpmn:outgoing>r4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="re_clerk_review" name="Clerk reviews amount"><bpmn:incoming>r3_yes</bpmn:incoming><bpmn:incoming>r4</bpmn:incoming><bpmn:incoming>r5_yes</bpmn:incoming><bpmn:outgoing>r6</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="re_gw_reformulate" name="Reformulation needed?" default="r5_yes"><bpmn:incoming>r6</bpmn:incoming><bpmn:outgoing>r5_yes</bpmn:outgoing><bpmn:outgoing>r5_no</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="re_submit_manager" name="Submit to manager"><bpmn:incoming>r5_no</bpmn:incoming><bpmn:outgoing>r7</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="re_gw_threshold" name="Amount below threshold?" default="r8_yes"><bpmn:incoming>r7</bpmn:incoming><bpmn:outgoing>r8_yes</bpmn:outgoing><bpmn:outgoing>r8_no</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="re_approve" name="Approve promptly"><bpmn:incoming>r8_yes</bpmn:incoming><bpmn:outgoing>r9</bpmn:outgoing></bpmn:task>
    <bpmn:task id="re_manager_decision" name="Manager reviews and decides"><bpmn:incoming>r8_no</bpmn:incoming><bpmn:outgoing>r10</bpmn:outgoing></bpmn:task>
    <bpmn:task id="re_reimburse" name="Reimburse employee"><bpmn:incoming>r9</bpmn:incoming><bpmn:incoming>r10</bpmn:incoming><bpmn:outgoing>r12</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="re_end" name="Process complete"><bpmn:incoming>r12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="r1" sourceRef="re_start" targetRef="re_notify"/>
    <bpmn:sequenceFlow id="r2" sourceRef="re_notify" targetRef="re_gw_account"/>
    <bpmn:sequenceFlow id="r3_no" sourceRef="re_gw_account" targetRef="re_create_account" name="No"/>
    <bpmn:sequenceFlow id="r3_yes" sourceRef="re_gw_account" targetRef="re_clerk_review" name="Yes"/>
    <bpmn:sequenceFlow id="r4" sourceRef="re_create_account" targetRef="re_clerk_review"/>
    <bpmn:sequenceFlow id="r6" sourceRef="re_clerk_review" targetRef="re_gw_reformulate"/>
    <bpmn:sequenceFlow id="r5_yes" sourceRef="re_gw_reformulate" targetRef="re_clerk_review" name="Yes, reformulate"/>
    <bpmn:sequenceFlow id="r5_no" sourceRef="re_gw_reformulate" targetRef="re_submit_manager" name="No"/>
    <bpmn:sequenceFlow id="r7" sourceRef="re_submit_manager" targetRef="re_gw_threshold"/>
    <bpmn:sequenceFlow id="r8_yes" sourceRef="re_gw_threshold" targetRef="re_approve" name="Yes"/>
    <bpmn:sequenceFlow id="r8_no" sourceRef="re_gw_threshold" targetRef="re_manager_decision" name="No"/>
    <bpmn:sequenceFlow id="r9" sourceRef="re_approve" targetRef="re_reimburse"/>
    <bpmn:sequenceFlow id="r10" sourceRef="re_manager_decision" targetRef="re_reimburse"/>
    <bpmn:sequenceFlow id="r12" sourceRef="re_reimburse" targetRef="re_end"/>
  </bpmn:process>
</bpmn:definitions>
